# ─── SEDSP Frontend Environment ───
# Copy: cp .env.example .env  (hoặc npm run setup)

# Mock toàn bộ UI (không cần backend)
# VITE_USE_MOCK=true

# Hybrid: auth, products, categories, cart, orders, inventory, admin users,
# seller dashboard, sales-performance, reviews, image upload từ Spring Boot
VITE_USE_MOCK=false

# REST prefix — Vite proxy /api → http://localhost:8080
VITE_API_BASE_URL=/api/v1

# Backend origin (Swagger, health check)
VITE_BACKEND_ORIGIN=http://localhost:8080

# Backend env (application-dev.yml / application.yml) — cấu hình trên server:
# POSTGRES: localhost:5432/sedsp user postgres pass 123456
# REDIS: localhost:6379
# JWT_SECRET, CLOUDINARY_*, MAIL_*, GOOGLE_CLIENT_ID (optional)
