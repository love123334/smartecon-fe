# ─── SEDSP Frontend Environment ───
# Copy: cp .env.example .env  (hoặc npm run setup)

# Mock toàn bộ UI (không cần backend)
# VITE_USE_MOCK=true

# Hybrid: auth, products, categories, cart, orders, inventory, admin users,
# seller dashboard, sales-performance, reviews, image upload từ Spring Boot
VITE_USE_MOCK=false

# Local (Vite proxy /api → localhost:8080):
# VITE_API_BASE_URL=/api/v1
# VITE_BACKEND_ORIGIN=http://localhost:8080

# Production (Vercel) — trỏ thẳng tới backend public URL:
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=https://YOUR-API.onrender.com/api/v1
# VITE_BACKEND_ORIGIN=https://YOUR-API.onrender.com

VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=http://localhost:8080

# Backend env (application-dev.yml / application.yml) — cấu hình trên server:
# POSTGRES, REDIS, JWT_SECRET, CLOUDINARY_*, MAIL_*, CORS_ALLOWED_ORIGINS

# ─── Chatbot LLM (pattern Groq/OpenAI như demo Bedrock) ───
# Lấy key miễn phí: https://console.groq.com
# VITE_AI_ENABLED=true
# VITE_AI_API_KEY=gsk_...
# VITE_AI_API_BASE_URL=https://api.groq.com/openai/v1
# VITE_AI_MODEL=llama-3.3-70b-versatile
